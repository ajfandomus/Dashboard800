{
  "name": "SheetConfig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for this sheet (e.g. Orders, Suppliers)"
    },
    "sheet_key": {
      "type": "string",
      "description": "Unique key identifier (e.g. orders, suppliers)"
    },
    "spreadsheet_id": {
      "type": "string",
      "description": "Google Sheets spreadsheet ID"
    },
    "sheet_name": {
      "type": "string",
      "description": "Tab/sheet name within the spreadsheet"
    },
    "column_mapping": {
      "type": "array",
      "description": "Column mapping config: [{source, target, type, label}]",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "formulas": {
      "type": "array",
      "description": "Computed fields: [{name, expression, label, format}]",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "format": {
            "type": "string"
          }
        }
      }
    },
    "refresh_interval_minutes": {
      "type": "number",
      "default": 15,
      "description": "How often to refresh data from the sheet"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this sheet config is active"
    }
  },
  "required": [
    "name",
    "sheet_key"
  ]
}